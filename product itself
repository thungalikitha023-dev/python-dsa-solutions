class Solution(object):
    def productExceptSelf(self, nums):
        n=len(nums)
        r=[1]*(n)
        l=[1]*(n)
        d=[]
        l[0]=1
        for i in range(1,len(nums)):
            l[i]=l[i-1]*nums[i-1]
        r[n-1]=1
        for i in range(len(nums)-2,-1,-1):
            r[i]=r[i+1]*nums[i+1]
        for i in range(len(nums)):
            d.append(l[i]*r[i])
        return d 
